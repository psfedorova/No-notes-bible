rules_version = '2';
// Liber Arcanum shared books. Paste into Firebase console > Firestore Database > Rules > Publish.
// A book is read and written only by its members. One joins with the invite code the owner made.
// Each member writes only the ink docs named after their own uid, so nobody can erase another's ink.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function bookDoc(book) { return /databases/$(database)/documents/books/$(book); }
    function isMember(book) {
      return signedIn() && exists(/databases/$(database)/documents/books/$(book)/members/$(request.auth.uid));
    }
    function isOwner(book) { return signedIn() && get(bookDoc(book)).data.owner == request.auth.uid; }
    function goodName(d, max) { return d.name is string && d.name.size() >= 1 && d.name.size() <= max; }

    // each person's own list of the books they belong to
    match /users/{uid}/books/{book} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && goodName(request.resource.data, 60);
    }

    match /books/{book} {
      allow read: if isMember(book);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'owner', 'at'])
        && request.resource.data.owner == request.auth.uid
        && goodName(request.resource.data, 60);
      allow update: if isOwner(book)
        && request.resource.data.keys().hasOnly(['name', 'owner', 'at'])
        && request.resource.data.owner == resource.data.owner
        && goodName(request.resource.data, 60);

      match /invite/{doc} {
        allow read: if isMember(book);
        allow write: if isOwner(book) && doc == 'code'
          && request.resource.data.keys().hasOnly(['code'])
          && request.resource.data.code is string && request.resource.data.code.size() >= 24;
      }

      match /members/{uid} {
        allow read: if isMember(book);
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'code', 'at'])
          && goodName(request.resource.data, 40)
          && request.resource.data.code is string
          && (get(bookDoc(book)).data.owner == uid
              || request.resource.data.code == get(/databases/$(database)/documents/books/$(book)/invite/code).data.code);
        allow update: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'code', 'at'])
          && request.resource.data.code == resource.data.code
          && goodName(request.resource.data, 40);
        allow delete: if signedIn() && (uid == request.auth.uid || isOwner(book));
      }

      match /ink/{id} {
        allow read: if isMember(book);
        allow create, update: if isMember(book)
          && request.resource.data.keys().hasOnly(['uid', 'dev', 'n', 's', 'k', 'f', 'c', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n < 400
          && id == string(request.resource.data.n) + '_' + request.auth.uid
          && request.resource.data.s is string && request.resource.data.s.size() <= 8000
          && request.resource.data.k is list && request.resource.data.k.size() <= 8000;
        allow delete: if false;
      }
    }
  }
}
